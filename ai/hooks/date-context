#!/usr/bin/env python3
"""
Prompt-submit hook: state the current date and time as authoritative.

A model has no clock. Left to itself it reuses whatever date appeared earlier in
the conversation, which is right until a session crosses midnight or resumes the
next day — and then every dated path and deadline it writes is quietly wrong.
Re-stating it every turn is the fix, because the failure is silent otherwise.

Agents disagree on how a hook returns text to the model, so the shape is chosen
by `--format` rather than guessed:

    claude, codex   {"hookSpecificOutput": {"hookEventName": ..., "additionalContext": ...}}
    cursor          {"additional_context": ...}

Exits 0 whatever happens. A hook that fails a turn over a timestamp is worse
than the stale date it was added to prevent.
"""

import argparse
import json
import sys
from datetime import datetime

MESSAGE = (
    "Authoritative current date/time, re-checked this turn: {stamp}. Use THIS as "
    "the current date for daily_notes paths and any date-sensitive work — do not "
    "reuse an earlier date from the conversation."
)

# Weekday included on purpose: "next Tuesday" is unresolvable without it, and
# resolving relative dates as they are written is what the notes rules require.
STAMP_FORMAT = "%A %Y-%m-%d %H:%M %Z"


def payload(shape, text):
    """
    Wrap the message in the shape the calling agent expects.

    Args:
        shape (str): "claude", "codex", or "cursor".
        text (str): the message to hand to the model.

    Returns:
        dict: the object to write on stdout. An unrecognized shape falls back to
        the Claude/Codex form, which is the one two of the three agents share.

    Raises:
        None
    """

    if shape == "cursor":
        return {"additional_context": text}

    return {"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                   "additionalContext": text}}


def build_parser():
    """
    Describe this hook's command line.

    Args:
        None

    Returns:
        argparse.ArgumentParser: the configured parser.

    Raises:
        None
    """

    parser = argparse.ArgumentParser(
        prog="date-context",
        description="Emit the current date and time as a hook context injection.")
    parser.add_argument("--format", dest="shape", default="claude",
                        choices=("claude", "codex", "cursor"),
                        help="which agent's hook output shape to emit")

    return parser


def main():
    """
    Write the timestamp injection on stdout.

    Args:
        None

    Returns:
        int: always 0.

    Raises:
        SystemExit: the arguments are invalid or --help was requested.
    """

    args = build_parser().parse_args()

    # Consume stdin if the agent sends a payload, so it never blocks on a pipe
    # nobody drains. Nothing here needs what it says.
    if not sys.stdin.isatty():
        sys.stdin.read()

    stamp = datetime.now().astimezone().strftime(STAMP_FORMAT)

    json.dump(payload(args.shape, MESSAGE.format(stamp=stamp)), sys.stdout)

    return 0


if __name__ == "__main__":
    sys.exit(main())
