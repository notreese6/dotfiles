#!/usr/bin/env python3
"""
Declare this machine an unattended agent box, and set up the isolation that
follows from saying so.

The role is per-machine and recorded on local disk, never in a dotfile that a
shared or synced home would carry to another machine. Everything else — which
config directory the agent uses, whether a sandbox wraps it, what the prompt
says — is derived from that one marker.

Site-specific hardening is optional and lives outside this repo; see load_site.
"""

import argparse
import importlib.util
import json
import os
import shutil
import subprocess
import sys

from pathlib import Path


HOME = Path.home()

# The rules library already resolves every shared location — where the config
# lives, where the assembled rules land. Re-deriving that here would be a second
# answer to a question that already has one, and the two would drift silently.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

try:
    import airules
except ImportError:
    airules = None


def config_home():
    """
    Locate the user's config directory.

    Args:
        None

    Returns:
        pathlib.Path: the rules library's answer where it is importable, so both
        tools agree, and the XDG default otherwise.

    Raises:
        None
    """

    if airules:
        return airules.config_path().parent.parent

    return Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))


def assembled_rules():
    """
    Locate the assembled rules file the agent reads.

    Args:
        None

    Returns:
        pathlib.Path: the library's answer, or the conventional location when
        the library cannot be imported.

    Raises:
        None
    """

    override = os.environ.get("AUTORUN_RULES_FILE")

    if override:
        return Path(override)

    if airules:
        return airules.assembled_path()

    return config_home() / "ai-notes" / "rules.md"


CONFIG_HOME = config_home()

# Resolved from this script's own location rather than from configuration: the
# unattended rules ship in the same checkout as this command, so the checkout
# that is running is by definition the one whose rules apply. A configured path
# could name a different checkout entirely.
AI_DIR = Path(os.environ.get("AUTORUN_AI_DIR", Path(__file__).resolve().parent.parent))

SITE_DIR   = Path(os.environ.get("AUTORUN_SITE_DIR", CONFIG_HOME / "autorun-mode/site"))
RULES_FILE = assembled_rules()

# The two values the marker file may hold. Deliberately not pushed into the
# shared config: they are a contract private to this feature, and the only
# duplication that can actually drift is bash/machine-role.sh, which cannot
# import Python and has to compare the string itself.
ROLE_AUTORUN     = "autorun"
ROLE_INTERACTIVE = "interactive"

SHIM_MARKER = "Generated by autorun-mode"


def load_site():
    """
    Import the optional site profile.

    A site profile supplies the facts this command cannot know — which tree is
    writable, which is shared — plus any hardening peculiar to one employer or
    lab. Keeping it out of tree is what lets the public repo stay generic.

    Args:
        None

    Returns:
        module: the imported site profile, or None when no profile is installed.
        A profile may define WORKSPACE (str), READONLY (str), and any of the
        hooks on(), off(), status().

    Raises:
        None. An unimportable profile is reported and treated as absent, because
        a broken site file should not stop a machine from being configured.
    """

    path = SITE_DIR / "site.py"

    if not path.is_file():
        return None

    try:
        spec   = importlib.util.spec_from_file_location("autorun_site", path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except Exception as exc:
        print(f"[-] site profile at {path} failed to load: {exc}", file=sys.stderr)
        return None


SITE      = load_site()
WORKSPACE = os.environ.get("AUTORUN_WORKSPACE") or getattr(SITE, "WORKSPACE", "")
READONLY  = os.environ.get("AUTORUN_READONLY")  or getattr(SITE, "READONLY",  "")

# Where this machine's own state goes. The generic default is an ordinary XDG
# path, which is right on a laptop and on any machine whose home is its own.
#
# A site profile overrides it, and that is the point: on a machine whose home is
# a shared network volume, "somewhere under ~" is exactly the wrong answer, and
# only the site knows which local path is right. Deriving it from the profile
# rather than from a symlink under ~ means this command does not depend on the
# home directory having been rearranged first.
STATE_DIR = Path(
    os.environ.get("AUTORUN_STATE_DIR")
    or getattr(SITE, "STATE_DIR", "")
    or Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "autorun-mode"
)

ROLE_FILE  = STATE_DIR / "machine-role"
CONFIG_DIR = STATE_DIR / "claude-autorun"

# The shim gets its own directory rather than sitting in ~/.local/bin, where the
# real agent binary already lives — writing it there would overwrite the binary.
# bash/machine-role.sh puts this on PATH only while the role is autorun, which is
# what makes `off` take effect without uninstalling anything.
SHIM_DIR = STATE_DIR / "autorun-bin"
SHIM     = SHIM_DIR / "claude"


def current_role():
    """
    Read the role recorded on this machine.

    Args:
        None

    Returns:
        str: "autorun" or "interactive". An absent, empty, or unrecognized
        marker reads as "interactive" — the unattended role is only ever held
        deliberately, never inherited by accident.

    Raises:
        None
    """

    try:
        role = ROLE_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ROLE_INTERACTIVE

    return ROLE_AUTORUN if role == ROLE_AUTORUN else ROLE_INTERACTIVE


def sandbox_runtime():
    """
    Name the sandbox runtime available here.

    Args:
        None

    Returns:
        str: "bwrap", "podman", "docker", or "" when none is usable. bwrap is
        preferred: it needs no daemon and no group membership, so it works on a
        locked-down host where the container runtimes do not.

    Raises:
        None
    """

    if shutil.which("bwrap"):
        return "bwrap"

    if shutil.which("podman"):
        return "podman"

    # Docker only counts if this user can actually reach the daemon.
    if shutil.which("docker"):
        try:
            subprocess.run(["docker", "info"], capture_output=True, timeout=10, check=True)
            return "docker"
        except (subprocess.SubprocessError, OSError):
            pass

    return ""


def dangling_links():
    """
    Find symlinks in the home directory whose targets do not exist.

    On a machine whose home is shared but whose local disk is not, every symlink
    pointing off the shared volume arrives already present and already broken.
    Deriving the list from the links themselves means a new link never has to be
    added to a hardcoded list here.

    Args:
        None

    Returns:
        list[tuple[pathlib.Path, pathlib.Path]]: (link, target) pairs, target
        resolved to an absolute path. Empty when nothing is broken.

    Raises:
        None
    """

    broken = []

    # Depth 2 covers ~/.claude/projects and friends without walking the whole
    # tree, which on a network home is slow enough to notice.
    candidates = list(HOME.glob("*")) + list(HOME.glob("*/*"))

    for link in candidates:
        if not link.is_symlink():
            continue

        target = Path(os.path.realpath(link))

        # Only targets off the home volume are ours to create; a broken link
        # inside the home directory is somebody else's bug.
        if not target.exists() and not str(target).startswith(str(HOME) + os.sep):
            broken.append((link, target))

    return broken


def write_claude_md():
    """
    Compose the agent instructions this machine reads when unattended.

    Built from imports rather than copies, so the shared rules stay
    authoritative and this box never writes to them.

    Args:
        None

    Returns:
        list[pathlib.Path]: the files that were imported, in order.

    Raises:
        OSError: CONFIG_DIR is not writable.
    """

    # Order is load-bearing: general rules first, unattended overrides second,
    # site overrides last, so the more specific file wins where they disagree.
    autorun_rules = AI_DIR / "autorun" / "autorun.md"
    sources       = [RULES_FILE, autorun_rules, SITE_DIR / "rules.md"]
    present       = [p for p in sources if p.is_file()]

    # The unattended rules are the entire reason this mode is safe to turn on.
    # Quietly leaving them out because a path moved would produce a box running
    # autonomously with none of its constraints and nothing saying so.
    if autorun_rules not in present:
        raise FileNotFoundError(
            f"unattended rules not found at {autorun_rules} — refusing to compose "
            f"instructions without them (set AUTORUN_AI_DIR to the ai/ directory holding them)"
        )

    (CONFIG_DIR / "CLAUDE.md").write_text(
        "".join(f"@{p}\n" for p in present), encoding="utf-8"
    )

    return present


def write_settings():
    """
    Write the deny-rules the unattended agent runs under.

    These are a second line of defence, not the boundary. A permission rule is
    enforced by the agent harness, so a shell command that reaches around it is
    not stopped by anything here — the sandbox is what actually constrains the
    process. Both are worth having.

    Args:
        None

    Returns:
        None

    Raises:
        OSError: CONFIG_DIR is not writable.
    """

    deny = ["Bash(git push --force*)", "Bash(git push -f*)"]

    if READONLY:
        deny = [f"Write({READONLY}/**)", f"Edit({READONLY}/**)"] + deny

    settings = {"permissions": {"deny": deny}}

    (CONFIG_DIR / "settings.json").write_text(
        json.dumps(settings, indent=2) + "\n", encoding="utf-8"
    )


def link_shared_dirs():
    """
    Link read-mostly directories from the normal agent config into this one.

    Skills and plugins are worth sharing between roles; settings, credentials
    and session state deliberately are not, because on a shared home they would
    become a cross-machine write race.

    Args:
        None

    Returns:
        None

    Raises:
        None. An individual link that cannot be made is skipped silently — it
        costs the box a convenience, not its isolation.
    """

    for name in ("skills", "plugins"):
        source = HOME / ".claude" / name
        dest   = CONFIG_DIR / name

        if source.exists() and not dest.exists():
            try:
                dest.symlink_to(source)
            except OSError:
                pass


def install_shim():
    """
    Install a PATH shim that runs the agent inside a sandbox.

    The shim takes the name of the real binary and sits earlier in PATH, so an
    ordinary invocation — including one passing --dangerously-skip-permissions —
    is confined without anyone having to remember a different command. That is
    the point: the protection must not depend on being invoked correctly.

    Args:
        None

    Returns:
        str: the runtime used, or "" when no shim was installed. Skipping is
        normal and non-fatal; the caller reports why.

    Raises:
        None
    """

    runtime = sandbox_runtime()

    # Resolve the real binary with the shim directory removed from PATH, so a
    # re-run never resolves to the shim installed last time and builds an exec
    # loop that would spin the moment anyone typed the command.
    clean = os.pathsep.join(
        p for p in os.environ.get("PATH", "").split(os.pathsep) if p != str(SHIM_DIR)
    )
    real = shutil.which("claude", path=clean)

    if not real:
        print("[-] no claude binary found — skipping sandbox shim")
        return ""

    if not runtime:
        print("[-] no sandbox runtime (bwrap/podman/docker) — skipping shim")
        print("[!] deny-rules still apply, but they are not a security boundary")
        return ""

    if not WORKSPACE:
        print("[-] no workspace declared — skipping shim")
        print("[*] set WORKSPACE in the site profile to say which tree is writable")
        return ""

    if runtime != "bwrap":
        print(f"[-] runtime is {runtime}; only bwrap shims are generated automatically")
        return ""

    # Refuse to write over anything that is not already our own shim. The real
    # binary one directory over is exactly the accident worth preventing.
    if SHIM.exists() and SHIM_MARKER not in SHIM.read_text(encoding="utf-8", errors="ignore"):
        print(f"[!] {SHIM} exists and was not generated here — leaving it alone", file=sys.stderr)
        return ""

    SHIM_DIR.mkdir(parents=True, exist_ok=True)

    SHIM.write_text(
        f"""#!/usr/bin/env bash
# {SHIM_MARKER}. Runs the agent with the home tree read-only and only the
# declared workspace writable. Remove with: autorun-mode off
exec bwrap \\
    --dev-bind / / \\
    --ro-bind "{READONLY or HOME}" "{READONLY or HOME}" \\
    --bind "{WORKSPACE}" "{WORKSPACE}" \\
    --bind "{STATE_DIR}" "{STATE_DIR}" \\
    --bind /tmp /tmp \\
    "{real}" "$@"
""",
        encoding="utf-8",
    )
    SHIM.chmod(0o755)

    return runtime


def cmd_on(args):
    """
    Turn the unattended role on for this machine.

    Args:
        args (argparse.Namespace): parsed arguments; unused.

    Returns:
        int: 0 on success, 1 when the local state directory is unusable — which
        on a shared home almost always means the local disk skeleton is missing.

    Raises:
        None
    """

    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"[-] cannot create {STATE_DIR}: {exc}", file=sys.stderr)
        print("[!] the state directory is unreachable. On a machine whose home is shared,\n"
              "    this usually means the local-disk layout has not been set up here yet.",
              file=sys.stderr)
        return 1

    # Everything that can fail happens before the marker is written. The marker
    # is what every other tool reads to decide this machine is unattended, so
    # writing it first would mean a failed run left the box claiming a role it
    # was not actually configured for — with no instructions and no sandbox.
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

    try:
        imported = write_claude_md()
    except FileNotFoundError as exc:
        print(f"[-] {exc}", file=sys.stderr)
        print("[!] autorun mode NOT enabled — nothing was changed.", file=sys.stderr)
        return 1

    ROLE_FILE.write_text(ROLE_AUTORUN + "\n", encoding="utf-8")

    write_settings()
    link_shared_dirs()

    print("[!] AUTORUN mode ON — agents on this machine run unattended")
    print(f"[+] role marker:  {ROLE_FILE}")
    print(f"[+] agent config: {CONFIG_DIR}")

    for path in imported:
        print(f"[*]   imports {path}")

    runtime = install_shim()

    if runtime:
        print(f"[+] sandbox shim: {SHIM} ({runtime})")
        print(f"[+] writable:     {WORKSPACE}")
        print(f"[+] read-only:    {READONLY or HOME}")

    if SITE and hasattr(SITE, "on"):
        SITE.on()

    print("[*] open a new shell for CLAUDE_CONFIG_DIR and the [AUTORUN] prompt badge")
    print("[!] agents already running still hold their previous config — restart them")
    return 0


def cmd_off(args):
    """
    Turn the unattended role off for this machine.

    Leaves the agent config directory in place: it holds no secrets, costs
    nothing, and keeping it means turning the mode back on need not rebuild it.

    Args:
        args (argparse.Namespace): parsed arguments; unused.

    Returns:
        int: 0 always.

    Raises:
        None
    """

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    ROLE_FILE.write_text(ROLE_INTERACTIVE + "\n", encoding="utf-8")

    # Only remove a shim this command generated; never a real binary someone
    # placed here by hand.
    if SHIM.is_file() and SHIM_MARKER in SHIM.read_text(encoding="utf-8", errors="ignore"):
        SHIM.unlink()
        print("[+] sandbox shim removed")

    if SITE and hasattr(SITE, "off"):
        SITE.off()

    print("[+] AUTORUN mode OFF — this is an ordinary interactive machine")
    print(f"[*] kept {CONFIG_DIR} (it holds this box's credentials and sessions);")
    print("    nothing reads it while the role is interactive")
    print("[*] open a new shell to drop CLAUDE_CONFIG_DIR and the prompt badge")
    print("[!] agents already running still hold the autorun config, sandbox included —")
    print("    restart them before assuming this machine is unconstrained")
    return 0


def cmd_status(args):
    """
    Report what is currently set up on this machine.

    Args:
        args (argparse.Namespace): parsed arguments; unused.

    Returns:
        int: 0 if the role is autorun, 1 if it is interactive, so a script can
        branch on the exit status.

    Raises:
        None
    """

    role    = current_role()
    runtime = sandbox_runtime()
    broken  = dangling_links()

    print(f"[*] machine role: {role}")
    print(f"      state dir:    {STATE_DIR}")
    print(f"      agent config: {CONFIG_DIR} ({'present' if CONFIG_DIR.is_dir() else 'absent'})")
    print(f"      sandbox:      {runtime or 'none available'}")
    print(f"      shim:         {SHIM if SHIM.is_file() else 'not installed'}")
    print(f"      workspace rw: {WORKSPACE or '<unset>'}")
    print(f"      read-only:    {READONLY or '<unset>'}")
    print(f"      site profile: {SITE_DIR if SITE else 'none'}")

    if broken:
        print(f"[-] {len(broken)} dangling home symlink(s) — this machine's local disk\n    layout is incomplete; fix it with your home-layout tool, not this one")

    if SITE and hasattr(SITE, "status"):
        SITE.status()

    return 0 if role == ROLE_AUTORUN else 1


def build_parser():
    """
    Build the command-line parser.

    Args:
        None

    Returns:
        argparse.ArgumentParser: parser whose subcommands each set `run` to the
        function implementing them.

    Raises:
        None
    """

    parser = argparse.ArgumentParser(
        prog="autorun-mode",
        description="Mark this machine as an unattended agent box, and set up the isolation "
                    "that follows. The role is stored per-machine on local disk, so it never "
                    "follows a shared or synced home to another box.",
    )
    sub = parser.add_subparsers(dest="command")

    on = sub.add_parser("on", help="mark this machine unattended")
    on.set_defaults(run=cmd_on)

    off = sub.add_parser("off", help="return this machine to ordinary interactive use")
    off.set_defaults(run=cmd_off)

    status = sub.add_parser("status", help="report the current role and setup")
    status.set_defaults(run=cmd_status)


    # Bare invocation reports rather than changes anything.
    parser.set_defaults(run=cmd_status)

    return parser


def main():
    """
    Entry point.

    Args:
        None

    Returns:
        int: the exit status of the selected subcommand.

    Raises:
        None
    """

    args = build_parser().parse_args()

    return args.run(args)


if __name__ == "__main__":
    sys.exit(main())
